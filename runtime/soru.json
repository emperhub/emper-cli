{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#090d0c",
    "darkPanel": "#0f1714",
    "darkElement": "#17221e",
    "darkMenu": "#111a17",
    "darkBorder": "#22312c",
    "darkBorderActive": "#5ee0b5",
    "darkBorderSubtle": "#1f2d28",
    "darkPrimary": "#2f806a",
    "darkSecondary": "#76a9fa",
    "darkAccent": "#f3b562",
    "darkError": "#ff6b77",
    "darkWarning": "#f3b562",
    "darkSuccess": "#5ee0b5",
    "darkInfo": "#69d2e7",
    "darkText": "#e8f2ee",
    "darkMuted": "#81918a",
    "lightBg": "#f6f9f7",
    "lightPanel": "#eef3f0",
    "lightElement": "#e3ece7",
    "lightMenu": "#e7efeb",
    "lightBorder": "#a9bbb2",
    "lightBorderActive": "#087f5b",
    "lightBorderSubtle": "#c8d5cf",
    "lightPrimary": "#24755f",
    "lightSecondary": "#2f6fdb",
    "lightAccent": "#b66b00",
    "lightError": "#c92a3a",
    "lightWarning": "#9a5a00",
    "lightSuccess": "#2b8a3e",
    "lightInfo": "#087e8b",
    "lightText": "#18211e",
    "lightMuted": "#64736c"
  },
  "theme": {
    "primary": { "dark": "darkPrimary", "light": "lightPrimary" },
    "secondary": { "dark": "darkSecondary", "light": "lightSecondary" },
    "accent": { "dark": "darkAccent", "light": "lightAccent" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkWarning", "light": "lightWarning" },
    "success": { "dark": "darkSuccess", "light": "lightSuccess" },
    "info": { "dark": "darkInfo", "light": "lightInfo" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "selectedListItemText": { "dark": "darkText", "light": "lightBg" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "backgroundMenu": { "dark": "darkMenu", "light": "lightMenu" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkSuccess", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBorderSubtle", "light": "lightBorderSubtle" },
    "diffAdded": { "dark": "#74d9b0", "light": "#18794e" },
    "diffRemoved": { "dark": "#ff7b86", "light": "#b42334" },
    "diffContext": { "dark": "#94a9a0", "light": "#61736a" },
    "diffHunkHeader": { "dark": "darkSecondary", "light": "lightSecondary" },
    "diffHighlightAdded": { "dark": "#9be8c8", "light": "#0b6b49" },
    "diffHighlightRemoved": { "dark": "#ff9aa3", "light": "#a61e2d" },
    "diffAddedBg": { "dark": "#102a21", "light": "#d9f2e7" },
    "diffRemovedBg": { "dark": "#30171b", "light": "#f8dfe2" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "darkMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "#16372b", "light": "#c8e8da" },
    "diffRemovedLineNumberBg": { "dark": "#3b1c22", "light": "#efcdd2" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkSuccess", "light": "lightPrimary" },
    "markdownLink": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownLinkText": { "dark": "darkInfo", "light": "lightInfo" },
    "markdownCode": { "dark": "darkSuccess", "light": "lightSuccess" },
    "markdownBlockQuote": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownEmph": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownStrong": { "dark": "darkSuccess", "light": "lightPrimary" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "darkSuccess", "light": "lightPrimary" },
    "markdownListEnumeration": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownImage": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownImageText": { "dark": "darkInfo", "light": "lightInfo" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "darkSecondary", "light": "lightSecondary" },
    "syntaxFunction": { "dark": "darkSuccess", "light": "lightPrimary" },
    "syntaxVariable": { "dark": "#ff8f9b", "light": "#b42334" },
    "syntaxString": { "dark": "darkSuccess", "light": "lightSuccess" },
    "syntaxNumber": { "dark": "darkAccent", "light": "lightAccent" },
    "syntaxType": { "dark": "darkInfo", "light": "lightInfo" },
    "syntaxOperator": { "dark": "#c2a7ff", "light": "#6f42c1" },
    "syntaxPunctuation": { "dark": "darkText", "light": "lightText" },
    "thinkingOpacity": 0.65
  }
}
